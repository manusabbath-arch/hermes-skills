      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/tools/guards/prod_write_guard.py\" --config \"$CLAUDE_PROJECT_DIR/tools/guards/prod_write_guard.json\""
          }
        ]
      }
    ]
  }
}
